# ==============================================================================
# GradFlow - Career Guidance & Information Portal Environment Variables
# ==============================================================================

# --- Public Client Variables (Vite Frontend) ---
# Note: In Vite, variables exposed to the client must be prefixed with VITE_
# Whitelisted Bangalore Engineering College Domains (cmrit.ac.in, rvce.edu.in, bmsce.ac.in, pes.edu, etc.)
VITE_COLLEGE_EMAIL_DOMAINS="cmrit.ac.in,rvce.edu.in,bmsce.ac.in,msrit.edu,pes.edu"
VITE_COLLEGE_NAME="50 Top Bangalore Engineering Colleges Placement Network"
VITE_APP_NAME="GradFlow"

# Firebase Client SDK Configuration (Safe for frontend bundle; protected by Firestore Security Rules)
# Provided automatically at runtime or configured via Firebase Web App settings
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# --- Server / Automation Secrets (DO NOT EXPOSE IN CLIENT BUNDLE) ---
# Required for server-side proxy routes and GitHub Actions Midnight Scraper
GEMINI_API_KEY=""
APP_URL=""

# GitHub Actions Repository Secrets (Set in GitHub Repo Settings -> Secrets and Variables -> Actions):
# - GH_PAT: GitHub Personal Access Token (with repo / workflow permissions for scheduled dispatch)
# - FIREBASE_SERVICE_ACCOUNT_KEY: Base64 or raw JSON string of Firebase Admin Service Account
# - SCRAPER_API_KEY: Optional API token for third-party job/hackathon aggregators (e.g., Adzuna, RapidAPI)
# - GEMINI_API_KEY: Google Gemini API key for Midnight Scraper opportunity summarization
